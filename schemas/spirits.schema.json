{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spirits file",
  "$defs": {
    "Spirit": {
      "additionalProperties": false,
      "description": "A bottled spirit.\n\nThe distillery is referenced via ``distillery_id``. If no distillery entry exists, only\n``distillery_name`` may be given as free-text fallback; at least one of both is required.",
      "properties": {
        "_id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "category_id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Category Id",
          "type": "string"
        },
        "abv": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Abv",
          "type": "number"
        },
        "distillery_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distillery Id"
        },
        "distillery_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distillery Name"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "_id",
        "name",
        "category_id",
        "abv"
      ],
      "title": "Spirit",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Spirit"
    },
    {
      "items": {
        "$ref": "#/$defs/Spirit"
      },
      "type": "array"
    }
  ]
}
