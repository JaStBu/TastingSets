{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "distilleries file",
  "$defs": {
    "Distillery": {
      "additionalProperties": false,
      "description": "A distillery; ``country`` is an ISO 3166-1 alpha-2 code.",
      "properties": {
        "_id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "country": {
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "_id",
        "name",
        "country"
      ],
      "title": "Distillery",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Distillery"
    },
    {
      "items": {
        "$ref": "#/$defs/Distillery"
      },
      "type": "array"
    }
  ]
}
